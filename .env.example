NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

QR_ALLOWED_HOSTS=viniciusgroup.com,drive.google.com

# Vercel AI Gateway (Vercel deployments can use OIDC; use an API key locally)
AI_GATEWAY_API_KEY=your_ai_gateway_api_key
AI_CHAT_MODEL=openai/gpt-5.6-luna
AI_EMBEDDING_MODEL=openai/text-embedding-3-small

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=replace_with_a_private_random_verify_token
META_APP_SECRET=your_meta_app_secret
WHATSAPP_GRAPH_API_VERSION=v23.0
